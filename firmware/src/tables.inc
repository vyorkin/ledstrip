; mode_tab: на режим 6 байт - speed0,speed1,speed2, dir0,dir1,dir2
;   скорость 8.8: 38 = 0.148 диода/кадр (30 диодов/с)
;   dir: бит 0: 0 = вправо, 1 = влево (XOR с flip)
;   старт: красный 10, зелёный 40, синий 80; центр MAXPOS/2
mode_tab:
    .db 38, 38, 38, 0x00, 0x00, 0x00   ; 0: все вправо
    .db 38, 38, 38, 0x01, 0x00, 0x01   ; 1: красный и синий влево, зелёный вправо
    .db 38, 38, 38, 0x00, 0x00, 0x01   ; 2: зелёный и синий сходятся к центру
    .db 38, 38, 38, 0x00, 0x01, 0x00   ; 3: зелёный и синий расходятся от центра

